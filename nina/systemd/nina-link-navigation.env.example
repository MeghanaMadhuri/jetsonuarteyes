# BLDC / navigation — optional overrides for nina-link + Sirena UI kiosk.
#
#   sudo mkdir -p /etc/nina-link
#   sudo cp nina/systemd/nina-link-navigation.env.example /etc/nina-link/navigation.env
#   sudo systemctl restart nina-link
#   systemctl --user restart nina-ui-kiosk
#
# Both nina-link.service and nina-ui-kiosk.service load this file for pin
# polarity and optional NINA_NAV_* BCM overrides.
#
# Remove if still present (obsolete Pi UART bridge): NINA_NAV_MODE,
# NINA_NAV_REMOTE_*, NINA_NAV_LEGACY_PI_BRIDGE.

# Jetson Orin Nano drives JYQDs directly (Jetson.GPIO / PWM).
NINA_NAV_INVERT_LEFT=1
NINA_NAV_INVERT_RIGHT=0

# --- Canonical Jetson Orin Nano loom (matches DEFAULT_PINS / pi_motor_bridge/PINMAP.md) ---
#
# Role          BCM    Physical    JYQD
# Left EL       24     18          EL
# Left Z/F       6     31          Z/F
# Left VR      12     32          VR   (hardware pwm0 — jetson-io)
# Right EL      10     19          EL
# Right Z/F     23     16          Z/F
# Right VR      13     33          VR   (hardware pwm2 — jetson-io)
# GND            —     39 / 34     GND
# Logic 5 V      —     2 or 4      5 V
#
# Override only if your harness differs (keep VR on BCM 12 & 13 unless you change PWM routing):
# NINA_NAV_L_EN=24
# NINA_NAV_L_DIR=6
# NINA_NAV_R_EN=10
# NINA_NAV_R_DIR=23
# NINA_NAV_L_PWM=12
# NINA_NAV_R_PWM=13
#
# Hoverboard lean (MX-28): straight D-pad uses NINA_HOVER_FWD_POS_* / REV_* only
# (set in navigation.env or code defaults). Code defaults: FWD L/R 2020/2083, REV 2068/2028.
# NINA_HOVER_FWD_POS_LEFT=2020
#
# Forward pulse (removed from HoverboardAxisDrive / UI). NINA_HOVER_PULSE_* kept in
# settings for compatibility only — ignored at runtime.
# # NINA_HOVER_PULSE_FORWARD=0
# #
# # Smooth coast↔forward ramps (see NINA_HOVER_PULSE_WAVEFORM).
# # Waveform: cosine = symmetric coast→FWD→coast over 2×RETURN_RAMP_SEC when holds are 0;
# # dual_ramp = two ramps (RETURN_RAMP_SEC each) + optional holds.
# # NINA_HOVER_PULSE_WAVEFORM=cosine
# # Default-style cycle: 2 s full forward + 2 s coast (near brake) = 4 s; ramps 0 = crisp steps.
# # NINA_HOVER_PULSE_FWD_SEC=2
# # NINA_HOVER_PULSE_BRAKE_SEC=2
# # NINA_HOVER_PULSE_RETURN_RAMP_SEC=0
# # COAST_BLEND 0..1: near-brake lean in forward pulse series (0=full brake; default 0.2).
# # NINA_HOVER_PULSE_COAST_BLEND=0.2
# # Backward pulse series (separate from forward): main hold, coast dwell, blend, return ramp.
# # NINA_HOVER_PULSE_SERIES_BACK_SEC=0.9
# # NINA_HOVER_PULSE_BACK_COAST_INITIAL_SEC=0.30
# # NINA_HOVER_PULSE_BACK_COAST_BLEND=0.2
# # NINA_HOVER_PULSE_BACK_RETURN_RAMP_SEC=0
# # Ramp blend: smootherstep (default quintic) | smoothstep | cubic_io | trapezoid (slow–fast–slow mid).
# # NINA_HOVER_PULSE_RAMP_PROFILE=smootherstep
# # Trapezoid only: accel/decel fraction each end (0.08–0.35).
# # NINA_HOVER_PULSE_RAMP_TRAP_EDGE=0.18
# # MX Moving Speed only during pulse ramps (unset = use NINA_HOVER_MOVING_SPEED).
# # NINA_HOVER_PULSE_RAMP_MOVING_SPEED=120
# # Optional: wait each ramp step until Present Position within TOL ticks of goal (timeout per step).
# # NINA_HOVER_PULSE_SYNC_PRESENT=1
# # NINA_HOVER_PULSE_PRESENT_TOL=4
# # NINA_HOVER_PULSE_PRESENT_STEP_TIMEOUT=0.25
# Drive straight bench (ms). Default 20_000 if unset.
# NINA_STRAIGHT_TEST_MS=20000
