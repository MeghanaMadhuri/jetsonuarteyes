# BLDC / navigation — optional overrides for nina-link + Sirena UI kiosk.
#
#   sudo mkdir -p /etc/nina-link
#   sudo cp nina/systemd/nina-link-navigation.env.example /etc/nina-link/navigation.env
#   sudo systemctl restart nina-link
#   systemctl --user restart nina-ui-kiosk
#
# Both nina-link.service and nina-ui-kiosk.service load this file for pin
# polarity and optional NINA_NAV_* BCM overrides.
#
# Remove if still present (obsolete Pi UART bridge): NINA_NAV_MODE,
# NINA_NAV_REMOTE_*, NINA_NAV_LEGACY_PI_BRIDGE.

# Jetson Orin Nano drives JYQDs directly (Jetson.GPIO / PWM).
NINA_NAV_INVERT_LEFT=1
NINA_NAV_INVERT_RIGHT=0

# --- Canonical Jetson Orin Nano loom (matches DEFAULT_PINS / pi_motor_bridge/PINMAP.md) ---
#
# Role          BCM    Physical    JYQD
# Left EL       24     18          EL
# Left Z/F       6     31          Z/F
# Left VR      12     32          VR   (hardware pwm0 — jetson-io)
# Right EL      10     19          EL
# Right Z/F     23     16          Z/F
# Right VR      13     33          VR   (hardware pwm2 — jetson-io)
# GND            —     39 / 34     GND
# Logic 5 V      —     2 or 4      5 V
#
# Override only if your harness differs (keep VR on BCM 12 & 13 unless you change PWM routing):
# NINA_NAV_L_EN=24
# NINA_NAV_L_DIR=6
# NINA_NAV_R_EN=10
# NINA_NAV_R_DIR=23
# NINA_NAV_L_PWM=12
# NINA_NAV_R_PWM=13
