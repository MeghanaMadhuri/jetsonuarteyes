# BLDC / navigation — optional overrides for nina-link (stock defaults are in nina-link.service).
#
#   sudo mkdir -p /etc/nina-link
#   sudo cp nina/systemd/nina-link-navigation.env.example /etc/nina-link/navigation.env
#   sudo systemctl restart nina-link
#
# nina-link.service loads EnvironmentFile=-/etc/nina-link/navigation.env after its built-ins.

# Default production path: Jetson Orin Nano drives JYQDs directly (Jetson.GPIO / PWM).
NINA_NAV_MODE=local
NINA_NAV_INVERT_LEFT=1
NINA_NAV_INVERT_RIGHT=0

# Legacy: offload motors to a Raspberry Pi running pi_motor_bridge over UART (unset lines above first).
# NINA_NAV_MODE=remote
# NINA_NAV_REMOTE_PORT=/dev/ttyTHS1
# NINA_NAV_REMOTE_BAUD=115200

# Pinout: as-built 40-pin harness (LEL 12, REL 19, LZF 15, RZF 32, signal L 18,
# signal R 13, GND 34+39). EL/DIR overrides below can match that loom.
#
# IMPORTANT (Jetson Orin Nano + Jetson.GPIO): speed (VR) MUST be driven on
# BCM 12 & 13 (phys 32 & 33) — that is what the firmware configures as PWM.
# If your harness brought VR to other pins (e.g. BCM 24 & 27), run jumpers to
# 32 & 33 or change the loom; do NOT only set NINA_NAV_*_PWM to non-PWM BCMs.
# NINA_NAV_L_EN=18
# NINA_NAV_L_DIR=22
# NINA_NAV_R_EN=10
# NINA_NAV_R_DIR=12
# (defaults) NINA_NAV_L_PWM=12  NINA_NAV_R_PWM=13
