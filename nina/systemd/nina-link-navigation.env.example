# BLDC / navigation — optional overrides for nina-link + Sirena UI kiosk.
#
#   sudo mkdir -p /etc/nina-link
#   sudo cp nina/systemd/nina-link-navigation.env.example /etc/nina-link/navigation.env
#   sudo systemctl restart nina-link
#   systemctl --user restart nina-ui-kiosk
#
# Both nina-link.service and nina-ui-kiosk.service load this file for pin
# polarity and optional NINA_NAV_* BCM overrides.
#
# Remove if still present (obsolete Pi UART bridge): NINA_NAV_MODE,
# NINA_NAV_REMOTE_*, NINA_NAV_LEGACY_PI_BRIDGE.

# Jetson Orin Nano drives JYQDs directly (Jetson.GPIO / PWM).
NINA_NAV_INVERT_LEFT=1
NINA_NAV_INVERT_RIGHT=0

# --- Canonical Jetson Orin Nano loom (matches DEFAULT_PINS / pi_motor_bridge/PINMAP.md) ---
#
# Role          BCM    Physical    JYQD
# Left EL       24     18          EL
# Left Z/F       6     31          Z/F
# Left VR      12     32          VR   (hardware pwm0 — jetson-io)
# Right EL      10     19          EL
# Right Z/F     23     16          Z/F
# Right VR      13     33          VR   (hardware pwm2 — jetson-io)
# GND            —     39 / 34     GND
# Logic 5 V      —     2 or 4      5 V
#
# Override only if your harness differs (keep VR on BCM 12 & 13 unless you change PWM routing):
# NINA_NAV_L_EN=24
# NINA_NAV_L_DIR=6
# NINA_NAV_R_EN=10
# NINA_NAV_R_DIR=23
# NINA_NAV_L_PWM=12
# NINA_NAV_R_PWM=13
#
# Hoverboard lean (MX-28): FWD_* = straight forward, REV_* = straight backward.
# Code defaults (no env): FWD 2022/2080, REV 2100/2000, SWAP off.
# NINA_HOVER_FWD_POS_LEFT=2022
# NINA_HOVER_FWD_POS_RIGHT=2080
# NINA_HOVER_REV_POS_LEFT=2100
# NINA_HOVER_REV_POS_RIGHT=2000
# NINA_HOVER_SWAP_FWD_REV_ENV_VALUES=0
#
# Audio output — pick ONE path:
#
# HDMI/DP (monitor speakers): scripts/setup-hdmi-audio.sh (also run from install-nina-ui-kiosk.sh).
# desktop/nina-ui-kiosk.service stops PipeWire before start so HDA is not busy.
# PERSISTENT_PIPE=1 (default) keeps one aplay stream open with idle silence to stop HDMI hiss.
# Example:
# NINA_GREET_APLAY_DEVICE=plughw:CARD=HDA,DEV=3
# NINA_AUDIO_MPG123_DEVICE=plughw:CARD=HDA,DEV=3
# NINA_AUDIO_MP3_VIA_APLAY=0
# NINA_AUDIO_OUTPUT_RATE=48000
# NINA_AUDIO_PERSISTENT_PIPE=1
# NINA_AUDIO_IDLE_OUTPUT_MUTE=1
# NINA_AUDIO_MIXER_CARD=HDA
# NINA_AUDIO_EDGE_SILENCE_MS=80
#
# MAX98357A I2S amplifier: scripts/setup-max98357a-audio.sh after jetson-io I2S enable.
# Example:
# NINA_GREET_APLAY_DEVICE=plughw:CARD=max98357a,DEV=0
# NINA_AUDIO_MPG123_DEVICE=plughw:CARD=max98357a,DEV=0
# NINA_AUDIO_MP3_VIA_APLAY=1
# NINA_AUDIO_APLAY_STEREO_MODE=left
# NINA_AUDIO_OUTPUT_RATE=48000
# NINA_AUDIO_OUTPUT_WARMUP_MS=100
# NINA_AUDIO_PREROLL_MS=0
# NINA_AUDIO_MUTE_PREROLL_SEC=0
# NINA_AUDIO_PERSISTENT_PIPE=1
# NINA_AUDIO_SILENCE_KEEPALIVE=1
# NINA_AUDIO_SILENCE_KEEPALIVE_SEC=2
# NINA_AUDIO_EDGE_SILENCE_MS=80
# NINA_AUDIO_APE_ROUTE=1
# NINA_AUDIO_APE_CARD=APE
# NINA_AUDIO_APE_I2S=I2S5
# NINA_AUDIO_APE_MUX=ADMAIF1
# NINA_AUDIO_APE_CHANNELS=2
# NINA_AUDIO_APE_BITS=16
# NINA_AUDIO_APE_FRAME_MODE=i2s
# NINA_AUDIO_APE_MASTER_MODE=cbs-cfs
# NINA_AUDIO_APE_BCLK_RATIO=16
# NINA_AUDIO_APE_FSYNC_WIDTH=1
# Optional pop suppression: wire MAX98357A SD/SD_MODE to a Jetson GPIO (BCM numbering).
# NINA_AUDIO_AMP_ENABLE_GPIO=23
# NINA_AUDIO_AMP_ENABLE_ACTIVE_HIGH=1
# NINA_AUDIO_AMP_PRE_ENABLE_MS=40
# NINA_AUDIO_AMP_POST_DISABLE_MS=80
#
# Edge voice assistant (local ASR + Ollama + TTS on loopback — no cloud gateway).
# 1) bash scripts/install-voice-edge.sh
# 2) bash scripts/start-voice-edge.sh   (separate terminal or systemd)
# 3) Enable below and restart nina-ui-kiosk
# NINA_VOICE_EDGE_ENABLE=1
# NINA_VOICE_ASSISTANT_ENABLE=1
# NINA_VOICE_DEVICE_ID=nina-jetson
# NINA_VOICE_ASR_URL=http://127.0.0.1:6000
# NINA_VOICE_LLM_URL=http://127.0.0.1:4000
# NINA_VOICE_TTS_URL=http://127.0.0.1:2000
# NINA_VOICE_MIC_DEVICE=default
# LLM_PRIMARY_MODEL=gemma2:2b
# ASR_MODEL_PATH=/home/jnx/Nvidia-jetson-platform/models/whisper-tiny
# Optional Piper TTS: PIPER_BIN=... PIPER_MODEL=... PIPER_CONFIG=...
#
# IR obstacle stop (GP2Y0E02B on I2C). At <= 400 mm, stop drive and run neutral pose.
# NINA_IR_OBSTACLE_STOP_ENABLE=1
# NINA_IR_OBSTACLE_MM=400
# NINA_IR_OBSTACLE_MOTION_GATED=1
# NINA_IR_OBSTACLE_I2C_BUS=7
# NINA_IR_OBSTACLE_I2C_ADDR=0x40
#
# ESP8266 eye display — Jetson USB cable → NodeMCU micro-USB (/dev/ttyUSB0).
# Not using 40-pin header UART for eyes on this robot.
NINA_EYE_UART_ENABLE=1
NINA_EYE_UART_PORT=/dev/ttyUSB0
NINA_EYE_UART_BAUD=115200
# NINA_EYE_UART_PORT=/dev/ttyTHS1

# ESP32 digital trigger on physical pin 11 (BCM 17) → namaste gesture.
# NINA_ESP32_TRIGGER_ENABLE=1
# NINA_ESP32_TRIGGER_GPIO=17
# NINA_ESP32_TRIGGER_ACTION=namaste
# NINA_ESP32_TRIGGER_DEBOUNCE=1
# NINA_ESP32_TRIGGER_DEBUG=1
# While the action plays, GPIO LOW eases arms to neutral (not an abrupt stop):
# NINA_ESP32_TRIGGER_RELEASE_RAMP_SEC=1.5
# NINA_ESP32_TRIGGER_RELEASE_RAMP_SPEED=0.35
#
# Straight FWD/BACK: drive-then-check loop (NOT the legacy coast/pulse ramp series).
# Each cycle: lean forward/back for NINA_HOVER_STRAIGHT_LEG_SEC (default 0.5 s) → brake →
# wait for standstill → read IMU cumulative drift → micro-step pivot L/R if needed → repeat.
# D-pad and Straight bench always use this on HoverboardAxisDrive. NINA_HOVER_PULSE_FORWARD
# only gates saved Movements straight segments (default 1 = enabled).
# # NINA_HOVER_PULSE_FORWARD=1
# Drive straight bench (ms). Default 40_000 if unset.
# NINA_STRAIGHT_TEST_MS=40000
# NINA_STRAIGHT_BACK_TEST_MS=40000
#
# IMU yaw drift HUD on Drive (header pins 3 SDA + 5 SCL → bus 7, addr 0x68):
# NINA_IMU_MPU9250_ENABLE=1
# NINA_IMU_I2C_BUS=7
# NINA_IMU_I2C_ADDR=0x68
#
# Pack voltage ADS1115 (218k/33k): pins 3 SDA + 5 SCL → bus 7 (i2cdetect -y -r 7 → 0x48).
# Bench: python3 -m nina.app.ads1115_bench_test
# NINA_BATTERY_ADS1115_ENABLE=1
# NINA_BATTERY_I2C_BUS=7

# AT42QT2120 touch @ 0x1c (same header I2C bus 7, pins 3/5)
# NINA_TOUCH_AT42QT2120_ENABLE=1
# NINA_TOUCH_I2C_BUS=7
# NINA_TOUCH_DETECT=keystatus
# NINA_TOUCH_CHANNEL=0
# DMR parity: reset+calibrate at start; threshold reg 0x10 (raise if too sensitive)
# NINA_TOUCH_CHIP_INIT=1
# NINA_TOUCH_THRESHOLD=25
# NINA_TOUCH_POLL_SEC=0.05
# NINA_TOUCH_DEBOUNCE=5
# NINA_TOUCH_RELEASE_READS=3
# NINA_TOUCH_PROBE_ATTEMPTS=5
# NINA_TOUCH_PROBE_DELAY_SEC=0.4
# Legacy inverted mask only if keystatus false-triggers on your wiring:
# NINA_TOUCH_USE_KEY_MASK=0
# NINA_TOUCH_BASELINE_CLEAR_READS=10
# NINA_TOUCH_STUCK_SEC=2
# NINA_TOUCH_STUCK_CLEAR_READS=15
# NINA_TOUCH_COOLDOWN_SEC=3
# NINA_TOUCH_BLIND_SEC=3
# NINA_TOUCH_CHANNEL_MASK=0xFFF
# NINA_BATTERY_R1_OHM=218000
# NINA_BATTERY_R2_OHM=33000
# NINA_BATTERY_CAL_SCALE=1.082
# NINA_BATTERY_CAL_OFFSET_V=0
# TEMP bench: low-battery latch at 24 V (default fleet 25.5 / clear 26.1).
# NINA_BATTERY_LOW_VOLTAGE_V=25.5
# NINA_BATTERY_CLEAR_VOLTAGE_V=26.1
# NINA_BATTERY_REPEAT_STEP_V=0.2
# NINA_BATTERY_REMINDER_SEC=90
# NINA_BATTERY_STARTUP_DEBOUNCE=1
# NINA_BATTERY_LATCH_PERSIST=1
# NINA_BATTERY_RESTART_SPEAK=1
#
# Yaw correction reuses held D-pad pivot goals; counter-yaw is swap-aware in code.
# If correction still yaws WITH the drift, try NINA_HOVER_IMU_CORR_INVERT_SIGN=1
# (IMU sign). Legacy knobs below are ignored — use NINA_HOVER_TURN_SWAP_PIVOT_DIR
# only if timed / D-pad turns rotate the wrong way:
# NINA_HOVER_TURN_SWAP_PIVOT_DIR=1
# NINA_HOVER_IMU_CORR_SWAP_PIVOT_DIR=0
# NINA_HOVER_STRAIGHT_CORR_SWAP_PIVOT_DIR=0
#
# Straight FWD/BACK only: smaller per-step yaw than D-pad (default 5° vs NINA_DRIVE_TURN_PIVOT_DEG 15°).
# NINA_HOVER_STRAIGHT_CORR_STEP_DEG=2.5
# NINA_HOVER_STRAIGHT_CORR_DEADBAND_DEG=3
# NINA_HOVER_STRAIGHT_CORR_RESIDUAL_DEG=1
# NINA_HOVER_STRAIGHT_LEG_SEC=0.5
#
# Saved Movements (Movements screen): outbound straight → 180° U-turn → return.
# U-turn steps are 180° (not 360°). While a sequence runs, turns use the same
# gentle 30% blend / hold-turn motor goals as D-pad L/R (~5° per micro-step),
# and straight-leg drift correction is skipped when |drift| exceeds the cap
# (avoids motor overload after a missed turn).
# NINA_HOVER_STRAIGHT_CORR_MAX_DRIFT_CORRECT_DEG=45
# NINA_HOVER_SEQUENCE_STRAIGHT_ABORT_DRIFT_DEG=45
# NINA_HOVER_SEQUENCE_TURN_OVERSHOOT_ABORT_DEG=35
# NINA_HOVER_SPIN_ABORT_RATE_DPS=45
# NINA_HOVER_POST_TURN_SETTLE_SEC=0.4
#
# Turn pacing: D-pad L/R, Turn buttons, and in-motion yaw realign during FWD/BACK pulse:
# NINA_HOVER_TURN_STEP_DUR_CAP_SEC=0.26
# NINA_HOVER_TURN_STEP_MIN_SEC=0.10
# NINA_HOVER_TURN_STEP_SETTLE_SEC=0.12
# NINA_HOVER_TURN_STEP_RATE_DEG_PER_SEC=22
# NINA_HOVER_TURN_PRE_SETTLE_SEC=0.28
# NINA_HOVER_TURN_POST_SETTLE_SEC=0.40
# NINA_DRIVE_HOLD_TURN_INTERVAL_SEC=0.52
# Timed pivot when IMU unavailable:
# NINA_NAV_TURN_SEC=0.45
#
# Straight forward trim (MX-28 id 12 left / 13 right) — with FWD 2022/2080 + 14 nudge:
# defaults L +2 → goal 2010, R +10 → goal 2104.
# NINA_HOVER_STRAIGHT_FWD_LEFT_TICKS_OFFSET=2
# NINA_HOVER_STRAIGHT_FWD_RIGHT_TICKS_OFFSET=10
#
# Dynamixel bus (FTDI U2D2 — do not share a ttyUSB with NINA_EYE_UART_PORT).
# Lean-only bench: NINA_DXL_EXPECTED_IDS=12,13 when arm servos 1–11 are unplugged.
# NINA_DXL_PORT=/dev/ttyUSB1
# NINA_DXL_BAUD=222222
# NINA_DXL_EXPECTED_IDS=12,13
