# Example environment fragment for nina-link (tablet gateway on Jetson).
# Copy lines into your systemd drop-in or `/etc/nina-link/*.env` — do not commit secrets.
#
# Full reference: docs/COMPANION_CONTROLS.md and sirena_ui/docs/NINA_APP.md

# --- Core HTTP token (optional; pairing PIN can mint a session token instead) ---
# NINA_LINK_TOKEN=replace-with-long-random-secret

# --- Bridges (default off; set to 1 only when you want the tablet to command hardware) ---
# NINA_LINK_ENABLE_ROBOT_BRIDGE=1
# NINA_LINK_ENABLE_RECORD_BRIDGE=1
# NINA_LINK_ENABLE_ACTION_BRIDGE=1
# NINA_LINK_ENABLE_VISION_BRIDGE=1
# NINA_LINK_ENABLE_SLAM_BRIDGE=1
# NINA_LINK_ENABLE_DEPTH_BRIDGE=1
# NINA_LINK_ENABLE_AUTONOMY_BRIDGE=1
# NINA_LINK_ENABLE_ACTIONS_STATIC=1

# --- Verbose HTTP trace (DEBUG logs; noisy with polling) ---
# NINA_LINK_HTTP_TRACE=1

# --- Logging of high-frequency GET pollers (default off) ---
# NINA_LINK_LOG_UI_POLL_GETS=1
