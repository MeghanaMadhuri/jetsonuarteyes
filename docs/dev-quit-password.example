# Copy to ~/.config/nina/dev_quit_password on the Jetson (one line, no quotes).
# chmod 600 ~/.config/nina/dev_quit_password
#
# Example:
# my-secret-password
#
# Or set in the kiosk environment:
#   systemctl --user edit nina-ui-kiosk
#   Environment=NINA_UI_DEV_QUIT_PASSWORD=my-secret-password
#
# Then: systemctl --user restart nina-ui-kiosk
#
# Exit kiosk: tap the Sirena logo in the sidebar 8 times within ~3 s,
# enter the password, and the app quits (Jetson keeps running).
