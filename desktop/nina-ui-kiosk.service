# systemd USER unit: Sirena Nina control center, kiosk mode.
#
# Installed by scripts/install-nina-ui-kiosk.sh (which substitutes
# __EXEC__ for the absolute path of scripts/launch-sirena.sh in the
# checked-out repo).
#
# This is a USER unit, not a system one - graphical apps must run as
# the desktop user so they can talk to X / Wayland. Enable it with:
#
#   systemctl --user enable --now nina-ui-kiosk.service
#
# And, on Jetson where the bot is supposed to come up automatically
# without a human typing a password:
#
#   sudo loginctl enable-linger "$USER"
#
# so the user manager survives across reboots even before a login.
#
# Logs:
#   journalctl --user -u nina-ui-kiosk -f
#   tail -f ~/.cache/sirena/launch.log

[Unit]
Description=Sirena Nina control center (kiosk fullscreen)
# Don't try to start before the graphical session is up - launch-sirena.sh
# needs DISPLAY / XAUTHORITY which graphical-session.target sets.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple

# Qt + tablet gateway (8787) + cameras need more than the default 1024 FDs.
LimitNOFILE=8192

# This is the toggle introduced in sirena_ui main_window for the 10.1"
# panel: makes the GUI launch frameless and fullscreen at the panel's
# native 1024x600. F11 toggles fullscreen, F10 quits, both kept as
# escape hatches.
Environment=NINA_UI_FULLSCREEN=1

# launch-sirena.sh already sets QT_QPA_PLATFORM=xcb, but we re-export
# it here too so a stale env from the user session can't override it.
Environment=QT_QPA_PLATFORM=xcb

# Android companion gateway (same Python process as the kiosk — no
# second daemon). Bind HTTP on all interfaces so the tablet/phone can
# reach the Jetson on LAN. Closing the companion app only disconnects
# the client; Sirena UI keeps running.
Environment=NINA_ANDROID_GATEWAY=1
Environment=NINA_ANDROID_GATEWAY_ALL=1
Environment=NINA_LINK_HOST=0.0.0.0
Environment=NINA_LINK_PORT=8787
Environment=NINA_LINK_BOOT_AP=0
Environment=NINA_ANDROID_GATEWAY_BOOT_AP=0

# Tablet HTTP bridges: without these, the Android companion gets 503 on Drive /
# Vision / SLAM / etc. while Sirena UI still works (Qt uses NinaService directly).
# Operators who want HTTP read-only can `systemctl --user edit nina-ui-kiosk` and
# set the matching NINA_LINK_ENABLE_* vars to 0.
Environment=NINA_LINK_ENABLE_ROBOT_BRIDGE=1
Environment=NINA_LINK_ENABLE_ACTION_BRIDGE=1
Environment=NINA_LINK_ENABLE_RECORD_BRIDGE=1
Environment=NINA_LINK_ENABLE_VISION_BRIDGE=1
Environment=NINA_LINK_ENABLE_ACTIONS_STATIC=1
Environment=NINA_LINK_ENABLE_SLAM_BRIDGE=1
Environment=NINA_LINK_ENABLE_DEPTH_BRIDGE=1
Environment=NINA_LINK_ENABLE_AUTONOMY_BRIDGE=1

# Locomotion: hoverboard lean axes on the Dynamixel bus (MX-28 IDs 12/13; hall idle ~2048).
# Per-bot tuning lives in /etc/nina-link/navigation.env (EnvironmentFile
# below) — override NINA_HOVER_BRAKE_POS_*, NINA_HOVER_FWD_POS_*, etc.
# there without touching this unit. Per-wheel polarity (left BLDC wired
# the opposite way around from the right) is still expressed via the
# nav layer's INVERT flags so DriveController.set_invert_* works.
Environment=NINA_NAV_INVERT_LEFT=1
Environment=NINA_NAV_INVERT_RIGHT=0
EnvironmentFile=-/etc/nina-link/navigation.env
# Scrub legacy Pi-UART vars at unit start so a stale /etc env can't
# put the bot back into "remote" mode after the Pi bridge removal.
UnsetEnvironment=NINA_NAV_MODE NINA_NAV_REMOTE_PORT NINA_NAV_REMOTE_BAUD NINA_NAV_REMOTE_TIMEOUT_SEC NINA_NAV_REMOTE_TURN_TICK_SEC NINA_NAV_LEGACY_PI_BRIDGE

# Lidar selection. Current builds ship with the Slamtec RPLIDAR S2E
# (Ethernet/UDP, ~30 m). Override to `a1` for legacy bots running
# the old USB-serial RPLIDAR A1M8, or to `auto` for fleet images that
# need to support both. The factory in
# nina.sensors.lidar_factory.build_lidar reads this on startup and
# also picks SLAM map sizing defaults that match the chosen lidar's
# range, so changing this one var is the only thing the operator has
# to do when swapping hardware. See
# scripts/install-slamtec-s2e-jetson.sh for the host-side network
# bring-up.
Environment=NINA_LIDAR_MODEL=s2e
Environment=NINA_LIDAR_HOST=192.168.11.2
Environment=NINA_LIDAR_UDP_PORT=8089

# Straight D-pad forward/back: ``NINA_HOVER_FWD_POS_*`` / ``NINA_HOVER_REV_POS_*``
# (see load_settings); override in /etc/nina-link/navigation.env per robot.

# IMU (MPU-6050/9250 @ 0x68): header pins 3 SDA + 5 SCL → ``/dev/i2c-7`` (``i2cdetect -y 7``).
Environment=NINA_IMU_MPU9250_ENABLE=1
Environment=NINA_IMU_I2C_BUS=7
Environment=NINA_IMU_I2C_ADDR=0x68

# Pack voltage ADS1115 @ 0x48: header pins 3 SDA + 5 SCL → ``/dev/i2c-7`` (shared with IMU ok).
Environment=NINA_BATTERY_ADS1115_ENABLE=1
Environment=NINA_BATTERY_I2C_BUS=7
Environment=NINA_BATTERY_CAL_SCALE=1.082

# Capacitive touch AT42QT2120 @ 0x1c (same bus 7, pins 3/5).
Environment=NINA_TOUCH_AT42QT2120_ENABLE=1
Environment=NINA_TOUCH_I2C_BUS=7

# GP2Y0E02B IR cliff @ 0x40 (optional). If the sensor is not installed, set to 0
# to avoid I2C open retries (and use NINA_IR_DISABLE=1 as an alternative).
# Environment=NINA_IR_OBSTACLE_STOP_ENABLE=0
# Environment=NINA_BATTERY_R1_OHM=218000
# Environment=NINA_BATTERY_R2_OHM=33000
# Environment=NINA_BATTERY_CAL_SCALE=1.082

ExecStart=__EXEC__

# Restart on transient failure so a one-off Qt / camera hiccup doesn't
# leave the bot with a dead screen, but back off after a handful of
# crashes so a real bug doesn't pin a CPU.
Restart=on-failure
RestartSec=3
StartLimitBurst=5
StartLimitIntervalSec=60

[Install]
WantedBy=graphical-session.target
